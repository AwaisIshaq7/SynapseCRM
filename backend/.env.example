PORT=5000
MONGO_URI=mongodb+srv://username:password@host/database
JWT_SECRET=replace_with_a_long_random_secret
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
GROQ_API_KEY=your_groq_api_key
ALLOW_ADMIN_REGISTRATION=false

# Gmail SMTP — ONE sender mailbox for all app emails (reset links go TO any user email in DB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=your.sender@gmail.com
SMTP_PASS=your_16_character_app_password_no_spaces
EMAIL_FROM=SynapseCRM <your.sender@gmail.com>

# Demo login (seeded on server start)
DEMO_EMAIL=demo@synapsecrm.com
DEMO_PASSWORD=Demo@1234

# IMAP — fetch real inbox emails into customers + interactions (uses SMTP credentials by default)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER=          # optional; defaults to SMTP_USER
# IMAP_PASS=          # optional; defaults to SMTP_PASS (Gmail 16-char app password)
EMAIL_SYNC_LIMIT=200
EMAIL_SYNC_SINCE_DAYS=180
SYNC_EMAILS_ON_START=true
EMAIL_AUTO_SYNC_MINUTES=5

