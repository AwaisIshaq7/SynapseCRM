# Production Environment Configuration for SynapseCRM AI Service

# Flask Configuration
FLASK_ENV=production
DEBUG=false

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Redis Cache Configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# Gunicorn Workers (recommended: 2-4 x CPU cores)
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_TIMEOUT=60
